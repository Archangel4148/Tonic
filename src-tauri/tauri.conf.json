{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tonic",
  "version": "1.0.0",
  "identifier": "com.tonic.songbook",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tonic",
        "width": 1100,
        "height": 760,
        "minWidth": 360,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "Music",
    "shortDescription": "A musician's local songbook",
    "longDescription": "Tonic is a local-first songbook for importing, editing, transposing, and performing chord charts and MusicXML scores offline.",
    "copyright": "Copyright © Tonic contributors",
    "publisher": "Tonic",
    "homepage": "https://github.com/Archangel4148/Tonic",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
